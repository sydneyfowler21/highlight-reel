{
  "name": "highlight-reel",
  "description": "Build a 60-second highlight reel from a game recording and auto-detected moments.",
  "private": true,
  "license": "TODO",
  "repository": {
    "type": "git",
    "url": "https://github.com/sydneyfowler21/highlight-reel"
  },
  "type": "module",
  "scripts": {
    "test": "jest",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "start": "tsx src/api/server.ts",
    "dev": "tsx watch src/api/server.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.23"
  }
}
